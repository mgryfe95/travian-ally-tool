# Datenbank-Passwort: POSTGRES_PASSWORD und das Passwort in DATABASE_URL müssen übereinstimmen.
POSTGRES_PASSWORD=ally
DATABASE_URL=postgresql://ally:ally@db:5432/ally
APP_URL=http://localhost:3000             # Produktion: https://humans-travian.com (muss exakt die öffentliche URL sein)
AUTH_SECRET=change-me                     # mind. 32 zufällige Zeichen: openssl rand -base64 32
SYSTEMADMIN_EMAILS=max@example.com        # kommagetrennt; diese Accounts sind immer SYSTEMADMIN
SYSTEMADMIN_SETUP_CODE=                   # optional; Registrierungs-Code für SYSTEMADMIN_EMAILS (Default: AUTH_SECRET)
TRAVIAN_SERVER_URL=https://ts12.x1.europe.travian.com
TRAVIAN_ALLIANCE_ID=36                    # eine oder mehrere IDs, kommagetrennt (z. B. 36,7); alle gelten als „Eigene Allianz“. Weitere im Admin-UI.
IMPORT_CRON="15 * * * *"                #  stündlich prüfen, nur bei geändertem Hash importieren
INACTIVE_DAYS=3                           # Default, im Admin-UI überschreibbar
SMTP_HOST=                                # leer = kein E-Mail-Versand (Passwort-Reset aus)
SMTP_PORT=587
SMTP_SECURE=false                         # true für Port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ally Tool <noreply@humans-travian.com>
STORAGE_DIR=./storage                     # Chat-Anhänge (Docker: Volume /app/storage)
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_FILES=10                       # pro Nachricht
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                          # leer = claude-opus-5-5 (genauer); claude-sonnet-5-5 ist günstiger
VISION_PASSES=2                           # Lesedurchläufe je Screenshot (Konsens → höhere Konfidenz)
VISION_AUTO_ACCEPT=0.97                   # ab dieser Konfidenz automatisch übernehmen …
VISION_LEARNING_MIN=10                    # … aber erst nach so vielen bestätigten Screenshots je Art (Lernmodus)
